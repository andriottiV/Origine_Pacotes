# Browser-visible Supabase project URL and publishable key (fictitious examples).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only: required for managing access to the client portal. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Canonical application origin; server-only. Set the real production URL in Vercel.
SITE_URL=https://your-app.example


# Optional Web Push. Configure keys before building/redeploying; only this public
# key may reach the browser. Generate ONCE with npm run push:keys.
PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
# Server-only scheduler Bearer token: at least 32 random characters.
CRON_SECRET=
